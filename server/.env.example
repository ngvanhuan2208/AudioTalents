PORT=5000
CLIENT_URL=http://localhost:3000
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
MONGODB_URI=mongodb://127.0.0.1:27017/audiotalents
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/audiotalents_phase41d1_test
